{
  "name": "API Change Guardian",
  "url": "https://github.com/kavish924/API_agent",
  "description": "Opens one draft PR with the SDK bump and the code fix when a provider's change breaks your code.",
  "hook_attributes": {
    "url": "https://REPLACE-WITH-YOUR-WEBHOOK-HOST/webhook",
    "active": true
  },
  "redirect_url": "https://github.com/kavish924/API_agent",
  "public": false,
  "default_permissions": {
    "contents": "write",
    "pull_requests": "write",
    "issues": "write",
    "metadata": "read"
  },
  "default_events": []
}
