# Copy to .env for local development. Never commit .env.
# Every value here is a placeholder; real secrets live in Secret Manager when deployed.

# SQLite locally; Postgres when deployed (postgresql+psycopg://user:pass@host/db).
DATABASE_URL=sqlite:///guardian.db

# Where raw release notes, page snapshots and run output are stored locally.
GUARDIAN_BLOB_DIR=.guardian/blobs
# Unpacked SDK wheels for the agent's type checker
GUARDIAN_WORK_DIR=.guardian/work

# Set to true to stop every write to GitHub. Runs still happen and record "paused".
GUARDIAN_PAUSED=false

GUARDIAN_LOG_LEVEL=INFO

# LLM access. "none" until a provider is configured (decided in Phase 1).
GUARDIAN_LLM_PROVIDER=none
GUARDIAN_LLM_MODEL=

# Tier 2 fixer: agent (spec 11) or single-shot (spec 05)
GUARDIAN_FIX_MODE=agent
# Changed lines allowed per finding in a model-written diff
GUARDIAN_FIX_LINE_CAP=40

# Agent fixer budgets: per finding, and total agent cost per run (USD)
GUARDIAN_AGENT_MAX_STEPS=12
GUARDIAN_AGENT_MAX_PROPOSALS=3
GUARDIAN_AGENT_MAX_TOKENS=60000
GUARDIAN_AGENT_MAX_SECONDS=120
GUARDIAN_AGENT_RUN_COST_CAP=1.0

# Optional: a GitHub token for reading public release notes. Raises the rate limit
# from 60 to 5,000 requests an hour. Needs no scopes.
GUARDIAN_GITHUB_TOKEN=

# GitHub App (Phase 5). Leave empty for local CLI runs.
GUARDIAN_GITHUB_APP_ID=
GUARDIAN_GITHUB_PRIVATE_KEY=
GUARDIAN_GITHUB_WEBHOOK_SECRET=
