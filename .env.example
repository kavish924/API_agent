# Copy to .env for local development. Never commit .env.
# Every value here is a placeholder; real secrets live in Secret Manager when deployed.

# SQLite locally; Postgres when deployed (postgresql+psycopg://user:pass@host/db).
DATABASE_URL=sqlite:///guardian.db

# Where raw release notes, page snapshots and run output are stored locally.
GUARDIAN_BLOB_DIR=.guardian/blobs

# Set to true to stop every write to GitHub. Runs still happen and record "paused".
GUARDIAN_PAUSED=false

GUARDIAN_LOG_LEVEL=INFO

# LLM access. "none" until a provider is configured (decided in Phase 1).
GUARDIAN_LLM_PROVIDER=none
GUARDIAN_LLM_MODEL=

# GitHub App (Phase 5). Leave empty for local CLI runs.
GUARDIAN_GITHUB_APP_ID=
GUARDIAN_GITHUB_PRIVATE_KEY=
GUARDIAN_GITHUB_WEBHOOK_SECRET=
